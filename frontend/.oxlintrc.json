{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "import", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    "object-shorthand": "warn",

    "typescript/no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "typescript/no-floating-promises": ["warn", { "ignoreVoid": true, "ignoreIIFE": true }],
    "typescript/no-misused-promises": ["error", { "checksVoidReturn": { "arguments": false, "attributes": false } }],
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-mixed-enums": "error",
    "typescript/no-explicit-any": "off",

    "import/first": "warn",
    "import/newline-after-import": "warn",
    "import/no-named-as-default-member": "off",

    "react/react-in-jsx-scope": "off",
    "react/exhaustive-deps": "warn",
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "ignorePatterns": ["dist"]
}
